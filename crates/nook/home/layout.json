    "glass": false,
    "glassTint": 0.5,
    "haptics": true
  },
  "compact": [
    "dashboard"
  ],
  "expanded": [
    "dashboard",
    "app-launcher",
    "ai-workbench"
  ],
  "hidden": [
    "codex",
    "system-monitor",
    "now-playing",
    "weather",
    "world-clock",
    "iss",
    "timer",
    "herdr",
